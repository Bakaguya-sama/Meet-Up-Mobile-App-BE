NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
SWAGGER_ENABLED=true
PUBLIC_APP_BASE_URL=https://app.example.com

# Neon pooled connection for the running API.
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.aws.neon.tech/meetup?sslmode=require
# Neon direct connection for migrations and administrative tasks.
DATABASE_DIRECT_URL=postgresql://user:password@endpoint.region.aws.neon.tech/meetup?sslmode=require

REDIS_URL=redis://localhost:6379
# Max requests per identity in a 60-second fixed window; tune per deployment.
FRIEND_QR_SESSION_TTL_SECONDS=300
MEETUP_INVITE_RATE_LIMIT=30
FRIEND_QR_RATE_LIMIT=20

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=meetup-api
JWT_AUDIENCE=meetup-mobile

# Required because Google OAuth is enabled by this backend.
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
# Server-only key for BE-13. Enable Places API (New); never expose this key to mobile clients or logs.
GOOGLE_MAPS_API_KEY=

# BE-18: Haversine nearby threshold in metres (100..50000).
NEARBY_RADIUS_METERS=3000

# BE-27: external Gemini remains opt-in. Prompt version selects a reviewed source template.
GEMINI_API_KEY=
AI_EXPLANATION_ENABLED=false
MEETUP_PREFERENCE_AI_ENABLED=false
AI_EXPLANATION_PROMPT_VERSION=v1

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Keep false for local development and contract tests; BE-07 enables the real adapter.
FIREBASE_ENABLED=false
# Required in every non-test environment. Generate 32 random bytes and encode as base64.
DEVICE_TOKEN_ENCRYPTION_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root namespace for every Cloudinary public ID. Leave the chat namespace to the backend.
FILE_STORAGE_ROOT_FOLDER=mobile-meetup
# Domain namespace for chat media below FILE_STORAGE_ROOT_FOLDER.
CHAT_MEDIA_FOLDER=chat
