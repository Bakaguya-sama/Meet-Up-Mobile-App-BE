  // MeetUp Backend database schema
  // Import this file at https://dbdiagram.io/ to view the ERD.
  // Database: PostgreSQL + PostGIS. Current user locations stay in Redis with TTL.

  Project MeetUp_Backend {
    database_type: 'PostgreSQL'
    Note: 'Schema for the agreed project scope. Budget filter and Google priceLevel are intentionally excluded.'
  }

  Enum friendship_status {
    pending
    accepted
    rejected
    blocked
  }

  Enum meetup_status {
    draft
    inviting
    choosing
    selected
    cancelled
    finished
  }

  Enum meetup_member_status {
    invited
    accepted
    declined
    left
    removed
  }

  Enum preference_level {
    high
    normal
    avoid
  }

  Enum route_strategy {
    exact
    batch
    cluster
  }

  Enum report_status {
    open
    reviewing
    resolved
    dismissed
  }

  Table user_accounts {
    id uuid [pk]
    email varchar(255) [not null, unique]
    role varchar(20) [not null, default: 'user', note: 'Only user/admin. Provision admin through controlled database operations; never from public signup.']
    password_hash varchar(255) // Null for an account that only uses Google OAuth.
    display_name varchar(100) [not null]
    avatar_url varchar(1000)
    public_handle varchar(128) [unique, note: 'Nullable stable QR handle. It is opaque and never an internal account ID.']
    public_handle_disabled_at timestamptz [note: 'Non-null means handle must not resolve. Rotate replaces public_handle and clears this value.']
    is_locked boolean [not null, default: false]
    locked_reason varchar(500)
    last_login_at timestamptz
    created_at timestamptz [not null]
    updated_at timestamptz [not null]
    deleted_at timestamptz
  }

  Table oauth_identities {
    id uuid [pk]
    user_account_id uuid [not null]
    provider varchar(30) [not null, default: 'google']
    provider_account_id varchar(255) [not null]
    provider_email varchar(255)
    created_at timestamptz [not null]
    updated_at timestamptz [not null]

    Indexes {
      (provider, provider_account_id) [unique]
      (user_account_id, provider) [unique]
    }
  }

  Table user_sessions {
    id uuid [pk]
    user_account_id uuid [not null]
    refresh_token_hash varchar(255) [not null, unique]
    refresh_token_family_id uuid [not null]
    parent_session_id uuid
    replaced_by_session_id uuid
    device_name varchar(150)
    expires_at timestamptz [not null]
    revoked_at timestamptz
    reuse_detected_at timestamptz
    created_at timestamptz [not null]

    Indexes {
      (user_account_id, expires_at)
      (refresh_token_family_id)
    }
  }

  // user_a_id and user_b_id are stored in sorted UUID order.
  // This prevents two rows for the same friend pair.
  Table friendships {
    id uuid [pk]
    user_a_id uuid [not null]
    user_b_id uuid [not null]
    requested_by_id uuid [not null]
    status friendship_status [not null, default: 'pending']
    requested_at timestamptz [not null]
    responded_at timestamptz
    updated_at timestamptz [not null]

    Indexes {
      (user_a_id, user_b_id) [unique]
      (user_a_id, status)
      (user_b_id, status)
    }
    Note: 'CHECK user_a_id < user_b_id; requested_by_id must belong to the pair. Pending has no responded_at; terminal states require responded_at. BE-03 does not reopen rejected requests.'
  }

  Table user_preferences {
    id uuid [pk]
    user_id uuid [not null, unique]
    updated_at timestamptz [not null]

    Note: 'Long-term profile preference. It only pre-fills a meetup form.'
  }

  Table activity_tags {
    id smallint [pk]
    code varchar(50) [not null, unique] // food, coffee, movie, mall, park, entertainment
    display_name varchar(100) [not null]
    is_active boolean [not null, default: true]
  }

  Table user_preference_tags {
    user_preference_id uuid [not null]
    activity_tag_id smallint [not null]
    level preference_level [not null, default: 'normal']
    created_at timestamptz [not null]

    Indexes {
      (user_preference_id, activity_tag_id) [pk]
    }
  }

  Table privacy_settings {
    id uuid [pk]
    user_id uuid [not null, unique]
    sharing_mode varchar(30) [not null, default: 'off', note: 'off, friends, selected_friends, meetup_only']
    is_location_sharing_enabled boolean [not null, default: false, note: 'Configured flag = sharing_mode != off. Effective access also checks expiry.']
    sharing_expires_at timestamptz [note: 'Null = no time limit; required null when off.']
    use_approximate_location boolean [not null, default: false]
    nearby_feature_enabled boolean [not null, default: false]
    selected_friend_ids uuid[] [not null, note: 'Empty unless selected_friends; 1..100 unique other account IDs. Accepted friendship rechecked on every access.']
    updated_at timestamptz [not null]
  }

  Table meetup_sessions {
    id uuid [pk]
    organizer_id uuid [not null]
    title varchar(150) [not null]
    description varchar(1000)
    scheduled_at timestamptz [not null]
    invitation_deadline_at timestamptz [not null, note: 'Must be at or before scheduled_at.']
    vote_deadline_at timestamptz
    search_radius_m integer [not null]
    status meetup_status [not null, default: 'draft']
    chosen_recommendation_place_id uuid
    chosen_run_id uuid
    chosen_by_id uuid
    chosen_at timestamptz
    cancelled_at timestamptz
    finished_at timestamptz
    created_at timestamptz [not null]
    updated_at timestamptz [not null]

    Indexes {
      (organizer_id, status)
      (scheduled_at, status)
    }
  }

  // BE-33 durable invite-link state. Raw token is never persisted.
  Table meetup_invite_links {
    id uuid [pk]
    meetup_id uuid [not null]
    created_by_id uuid [not null]
    token_hash char(64) [not null, unique, note: 'SHA-256 lookup fingerprint, never raw token.']
    expires_at timestamptz [not null]
    revoked_at timestamptz
    revoked_by_id uuid
    use_count integer [not null, default: 0, note: 'Increments only when a distinct actor first becomes accepted through this link.']
    last_used_at timestamptz
    created_at timestamptz [not null]
    updated_at timestamptz [not null]

    Indexes {
      (meetup_id, revoked_at)
      (expires_at)
      (created_by_id, created_at)
    }

    Note: 'A non-revoked, non-expired link permits multiple distinct actors. create(revokePrevious=true) revokes active links and creates the replacement in one transaction.'
  }

  Table meetup_participants {
    id uuid [pk]
    meetup_id uuid [not null]
    user_id uuid [not null]
    status meetup_member_status [not null, default: 'invited']
    invited_by_id uuid [not null]
    responded_at timestamptz
    joined_at timestamptz
    left_at timestamptz

    Indexes {
      (meetup_id, user_id) [unique]
      (meetup_id, id) [unique]
      (user_id, status)
    }
  }

  // This is the authoritative preference for a meetup.
  Table meetup_participant_preferences {
    meetup_participant_id uuid [not null]
    activity_tag_id smallint [not null]
    level preference_level [not null, default: 'normal']
    source varchar(30) [not null, default: 'meetup_input'] // meetup_input or profile_fallback
    updated_at timestamptz [not null]

    Indexes {
      (meetup_participant_id, activity_tag_id) [pk]
    }
  }

  Table recommendation_runs {
    id uuid [pk]
    meetup_id uuid [not null]
    request_id uuid [not null]
    payload_hash char(64) [not null]
    requested_by_id uuid [not null]
    requested_k smallint [not null]
    status varchar(20) [not null, note: 'RUNNING, COMPLETED, FAILED']
    failure_code varchar(100)
    ranking_strategy varchar(50) [not null]
    algorithm_version varchar(100) [not null]
    config_version varchar(100) [not null]
    feature_schema_version varchar(100) [not null]
    provider_mapping_version varchar(100) [not null]
    provider_request_options_version varchar(100) [not null]
    opening_filter varchar(40) [not null, note: 'ANY, OPEN_AT_REQUEST_TIME, OPEN_AT_SCHEDULED_TIME']
    opening_evaluator_version varchar(100) [not null]
    routing_preference_requested varchar(30) [not null, note: 'TRAFFIC_UNAWARE or TRAFFIC_AWARE']
    routing_preference_effective varchar(30) [not null, note: 'May fall back to TRAFFIC_UNAWARE for the whole matrix.']
    weather_policy_requested varchar(30) [not null, note: 'OFF, WARN_ONLY, FILTER_OUTDOOR']
    weather_policy_effective varchar(30) [not null]
    weather_policy_version varchar(100) [not null]
    closing_policy_version varchar(100) [not null]
    requested_at timestamptz [not null]
    scheduled_at_snapshot timestamptz [not null]
    effective_k smallint
    warnings jsonb [not null, default: `'[]'::jsonb`]
    random_seed varchar(100)
    route_batch_count integer
    route_element_count integer
    created_at timestamptz [not null]
    completed_at timestamptz

    Indexes {
      (meetup_id, request_id) [unique, name: 'uq_recommendation_runs_request']
      (meetup_id, id) [unique, name: 'uq_recommendation_runs_meetup_id_id']
      (meetup_id, created_at) [name: 'idx_recommendation_runs_meetup_created']
    }

    Note: 'Step 1 run/idempotency metadata. Do not store individual member coordinates.'
  }

  Table recommendation_candidates {
    id uuid [pk]
    run_id uuid [not null]
    canonical_candidate_key varchar(300) [not null]
    provider varchar(50) [not null]
    provider_place_id varchar(255) [not null]
    name varchar(255) [not null]
    latitude double [not null, note: 'Provider place coordinate, -90..90; never a member coordinate.']
    longitude double [not null, note: 'Provider place coordinate, -180..180; never a member coordinate.']
    provider_types jsonb [not null]
    source_categories jsonb [not null]
    source_pages jsonb [not null]
    normalized_tags jsonb [not null, default: `'[]'::jsonb`]
    rating_0_to_5 double
    user_rating_count integer
    filter_status varchar(20) [not null, note: 'ELIGIBLE or FILTERED']
    filter_reason varchar(100)
    final_rank smallint
    group_utility double
    candidate_least_misery_utility double
    pareto_level integer
    inclusion_probability double
    avg_eta_seconds double
    max_eta_seconds double
    eta_range_seconds double
    scheduled_opening_status varchar(20) [note: 'OPEN, CLOSED, UNKNOWN; null when scheduled opening policy is not used.']
    opening_evidence jsonb
    weather_evidence jsonb [note: 'Normalized forecast evidence; no member location.']
    closing_evidence jsonb [note: 'Versioned scheduled closing risk/penalty evidence.']
    created_at timestamptz [not null]

    Indexes {
      (run_id, canonical_candidate_key) [unique, name: 'uq_recommendation_candidate']
      (run_id, filter_status) [name: 'idx_recommendation_candidates_run_status']
      (run_id, final_rank) [unique, name: 'uq_recommendation_candidates_run_rank', note: 'Partial unique index where final_rank is not null.']
    }
  }

  Table recommendation_member_features {
    id uuid [pk]
    run_id uuid [not null]
    candidate_id uuid [not null]
    participant_id uuid [not null]
    canonical_candidate_key varchar(300) [not null]
    eta_seconds double [not null]
    distance_meters double [not null]
    static_duration_seconds double [note: 'Provider metric/explanation only; never used by utility.']
    matched_tags jsonb [not null]
    missing_flags jsonb [not null]
    travel_utility double [not null]
    preference_utility double [not null]
    place_quality_utility double [not null]
    member_utility double [not null]
    ranking_utility double [not null, note: 'U_rank after closing penalty; member_utility remains U_base.']
    route_status varchar(20) [not null, note: 'Step 2 persists only OK route features.']
    created_at timestamptz [not null]

    Indexes {
      (run_id, participant_id, canonical_candidate_key) [unique, name: 'uq_recommendation_member_feature']
      (run_id, candidate_id) [name: 'idx_recommendation_member_features_run_candidate']
    }
  }

  // External place data persisted only when it is shown in a recommendation or saved as a favorite.
  Table place_snapshots {
    id uuid [pk]
    provider varchar(30) [not null, default: 'google_places']
    provider_place_id varchar(255) [not null]
    name varchar(255) [not null]
    formatted_address varchar(500)
    location geography [note: 'PostGIS geography(Point, 4326) for a place, not a user location.']
    primary_type varchar(100)
    rating numeric(3, 2)
    user_rating_count integer
    opening_status varchar(50) // open, closed, unknown
    opening_hours_json jsonb
    photo_reference varchar(500)
    captured_at timestamptz [not null]

    Indexes {
    (provider, provider_place_id) [unique]
      (location) [type: gist]
    }
  }

  Table recommendation_places {
    id uuid [pk]
    run_id uuid [not null]
    candidate_id uuid [not null]
    canonical_candidate_key varchar(300) [not null]
    rank smallint [not null]
    group_utility double [not null]
    candidate_least_misery_utility double [not null]
    pareto_level integer [not null]
    inclusion_probability double
    avg_eta_seconds double [not null]
    max_eta_seconds double [not null]
    eta_range_seconds double [not null]
    scheduled_opening_status varchar(20) [note: 'OPEN, CLOSED, UNKNOWN; null when scheduled opening policy is not used.']
    opening_evidence jsonb
    weather_evidence jsonb [note: 'Normalized forecast evidence used before routing.']
    closing_evidence jsonb [note: 'Versioned scheduled closing risk/penalty evidence.']
    explanation jsonb [not null, note: 'Deterministic summaryCode, sourced/unit-tagged facts and warnings from the persisted snapshot.']
    created_at timestamptz [not null]

    Indexes {
      (run_id, rank) [unique, name: 'uq_recommendation_places_run_rank']
      (run_id, candidate_id) [unique, name: 'uq_recommendation_places_candidate']
      (id, run_id) [unique, name: 'uq_recommendation_places_id_run']
    }

    Note: 'Step 3 aggregate result snapshot. One row per fully ranked candidate; API projects only rank <= effective_k.'
  }

  Table recommendation_place_etas {
    recommendation_place_id uuid [not null]
    meetup_participant_id uuid [not null]
    duration_seconds integer [not null]
    distance_m integer
    is_estimated boolean [not null, default: false]

    Indexes {
      (recommendation_place_id, meetup_participant_id) [pk]
    }
  }

  Table votes {
    id uuid [pk]
    meetup_id uuid [not null]
    run_id uuid [not null]
    recommendation_place_id uuid [not null]
    meetup_participant_id uuid [not null]
    created_at timestamptz [not null]
    updated_at timestamptz [not null]

    Indexes {
      (meetup_id, meetup_participant_id) [unique]
      (recommendation_place_id)
    }
  }

  Table favorite_places {
    id uuid [pk]
    user_id uuid [not null]
    provider varchar(50) [not null]
    provider_place_id varchar(255) [not null]
    canonical_candidate_key varchar(300) [not null]
    place_name varchar(255) [not null]
    created_at timestamptz [not null]

    Indexes {
      (user_id, canonical_candidate_key) [unique]
      (user_id, created_at)
    }
    Note: 'Contains only a small candidate snapshot. Never stores route history or exact user coordinates.'
  }

  Table chat_conversations {
    id uuid [pk]
    type varchar(20) [not null, note: 'direct or meetup']
    meetup_id uuid
    direct_user_a_id uuid
    direct_user_b_id uuid
    last_message_id uuid
    last_message_at timestamptz
    created_at timestamptz [not null]

    Indexes {
      meetup_id [unique, name: 'uq_chat_conversations_meetup']
      (direct_user_a_id, direct_user_b_id) [unique, name: 'uq_chat_conversations_direct_pair']
      (last_message_at, id)
    }

    Note: 'Unified direct/meetup conversation. A direct pair is canonical user A < user B and is created lazily on the first valid send. A meetup conversation is created atomically with the meetup. Shape and partial uniqueness are enforced by PostgreSQL.'
  }

  Table chat_conversation_members {
    conversation_id uuid [not null]
    user_id uuid [not null]
    joined_at timestamptz [not null]
    left_at timestamptz
    history_visible_until timestamptz
    last_read_message_id uuid
    last_read_at timestamptz

    Indexes {
      (conversation_id, user_id) [pk]
      (user_id, left_at, conversation_id)
    }

    Note: 'Direct members remain for retained read-only history after unfriend/block. Meetup membership is synchronized from meetup_participants; newly accepted members can read the complete earlier history, while former members stop at history_visible_until = left_at.'
  }

  Table chat_messages {
    id uuid [pk]
    conversation_id uuid [not null]
    sender_user_id uuid [not null]
    client_message_id uuid [not null]
    text_content varchar(2000) [not null, default: '']
    sent_at timestamptz [not null]

    Indexes {
      (conversation_id, sender_user_id, client_message_id) [unique]
      (conversation_id, sent_at, id)
    }

    Note: 'Immutable message shared by direct and meetup chat. client_message_id makes mobile retries idempotent. A deferred constraint requires text or at least one normalized attachment; a database trigger is the final send-authorization guard.'
  }

  Table chat_message_attachments {
    id uuid [pk]
    message_id uuid [not null]
    storage_provider varchar(30) [not null]
    storage_key varchar(500) [not null]
    resource_type varchar(20) [not null]
    format varchar(30) [not null]
    original_file_name varchar(180) [not null]
    mime_type varchar(150) [not null]
    bytes bigint [not null]
    sort_order smallint [not null]
    created_at timestamptz [not null]

    Indexes {
      (message_id, sort_order) [unique]
      (storage_provider, storage_key) [unique]
    }

    Note: 'Private Cloudinary metadata only. Never store file bytes, public URLs, short-lived signed URLs or antivirus/quarantine state. Storage keys are deterministic per conversation/clientMessageId/file index/content fingerprint.'
  }

  Table device_tokens {
    id uuid [pk]
    user_account_id uuid [not null]
    token_ciphertext text [not null] // AES-256-GCM envelope; never store plaintext FCM token.
    token_fingerprint char(64) [not null, unique] // HMAC-SHA-256 lookup value, not the token.
    platform varchar(10) [not null] // android or ios
    revoked_at timestamptz
    created_at timestamptz [not null]
    updated_at timestamptz [not null]

    Indexes {
      (user_account_id, revoked_at)
    }

    Note: 'BE-07 active FCM device tokens. Account deletion cascades to this table.'
  }

  Table notification_campaigns {
    id uuid [pk]
    campaign_name varchar(150) [not null]
    campaign_type varchar(30) [not null] // event_driven, scheduled, manual
    audience_filter_json jsonb
    title_template varchar(150) [not null]
    body_template varchar(500) [not null]
    scheduled_at timestamptz
    started_at timestamptz
    finished_at timestamptz
    created_by_user_id uuid
    created_at timestamptz [not null]
  }

  Table notification_deliveries {
    id uuid [pk]
    recipient_user_id uuid [not null]
    device_id uuid
    notification_campaign_id uuid
    meetup_id uuid
    notification_event varchar(50) [not null] // e.g. meetup_invitation, place_selected, nearby_friend
    title varchar(150) [not null]
    body varchar(500) [not null]
    data_json jsonb
  delivery_status varchar(30) [not null, default: 'pending'] // pending, sent, failed
    sent_at timestamptz
    read_at timestamptz
    failure_reason varchar(500)
    created_at timestamptz [not null]

    Indexes {
      (recipient_user_id, read_at)
      (meetup_id, notification_event)
    }
  }

  Table outbox_events {
    id uuid [pk]
    event_name varchar(100) [not null]
    destination varchar(20) [not null] // realtime or push
    recipient_ids uuid[] [not null]
    payload jsonb [not null]
    occurred_at timestamptz [not null]
    status varchar(20) [not null, default: 'pending'] // pending, delivered, failed
    attempt_count integer [not null, default: 0]
    last_error varchar(500)
    delivered_at timestamptz
    created_at timestamptz [not null]

    Indexes {
      (status, created_at)
    }

    Note: 'Written in the same transaction as a domain change. A worker publishes it to Socket.IO, FCM or other consumers.'
  }

  Table ai_explanation_cache {
    id uuid [pk]
    recommendation_run_id uuid [not null]
    input_hash varchar(64) [not null, unique]
    explanation varchar(1500) [not null]
    source varchar(30) [not null] // ai or rule_fallback
    expires_at timestamptz
    created_at timestamptz [not null]

    Note: 'Only receives aggregate ETA, ranking and preference data. No coordinates, GPS history or real name.'
  }

  Table nearby_preferences {
    user_id uuid [pk]
    radius_m integer [not null, default: 1000]
    cooldown_minutes integer [not null, default: 120]
    updated_at timestamptz [not null]
  }

  // user_a_id and user_b_id are stored in sorted UUID order.
  Table nearby_suggestion_cooldowns {
    user_a_id uuid [not null]
    user_b_id uuid [not null]
    last_suggested_at timestamptz [not null]

    Indexes {
      (user_a_id, user_b_id) [pk]
    }
  }

  Table user_reports {
    id uuid [pk]
    reporter_id uuid [not null]
    reported_user_id uuid [not null]
    reason varchar(1000) [not null]
    status report_status [not null, default: 'open']
    handled_by_id uuid
    handled_at timestamptz
    created_at timestamptz [not null]
  }

  Table audit_logs {
    id uuid [pk]
    actor_id uuid [not null]
    action varchar(100) [not null]
    subject_type varchar(100) [not null]
    subject_id uuid [not null]
    metadata_json jsonb [not null, default: '{}']
    created_at timestamptz [not null]

    Indexes {
      (subject_type, subject_id, created_at)
    }

    Note: 'Security and admin audit only. Do not store exact location, refresh token or sensitive AI payload.'
  }

  Ref: user_accounts.id < oauth_identities.user_account_id
  Ref: user_accounts.id < user_sessions.user_account_id
  Ref: user_accounts.id < favorite_places.user_id
  Ref: user_accounts.id < audit_logs.actor_id
  Ref: user_sessions.id < user_sessions.parent_session_id
  Ref: user_sessions.id < user_sessions.replaced_by_session_id
  Ref: user_accounts.id < friendships.user_a_id
  Ref: user_accounts.id < friendships.user_b_id
  Ref: user_accounts.id < friendships.requested_by_id
  Ref: user_accounts.id < user_preferences.user_id
  Ref: user_preferences.id < user_preference_tags.user_preference_id
  Ref: activity_tags.id < user_preference_tags.activity_tag_id
  Ref: user_accounts.id < privacy_settings.user_id
  Ref: user_accounts.id < meetup_sessions.organizer_id
  Ref: user_accounts.id < meetup_sessions.chosen_by_id
  Ref: meetup_sessions.id < meetup_invite_links.meetup_id
  Ref: user_accounts.id < meetup_invite_links.created_by_id
  Ref: user_accounts.id < meetup_invite_links.revoked_by_id
  Ref: meetup_sessions.id < meetup_participants.meetup_id
  Ref: user_accounts.id < meetup_participants.user_id
  Ref: user_accounts.id < meetup_participants.invited_by_id
  Ref: meetup_participants.id < meetup_participant_preferences.meetup_participant_id
  Ref: activity_tags.id < meetup_participant_preferences.activity_tag_id
  Ref: meetup_sessions.id < recommendation_runs.meetup_id
  Ref: user_accounts.id < recommendation_runs.requested_by_id
  Ref: recommendation_runs.id < recommendation_candidates.run_id [delete: cascade]
  Ref: recommendation_runs.id < recommendation_member_features.run_id [delete: cascade]
  Ref: recommendation_candidates.id < recommendation_member_features.candidate_id [delete: cascade]
  Ref: meetup_participants.id < recommendation_member_features.participant_id
  Ref: recommendation_runs.id < recommendation_places.run_id [delete: cascade]
  Ref: recommendation_candidates.id < recommendation_places.candidate_id [delete: cascade]
  Ref: recommendation_places.id < recommendation_place_etas.recommendation_place_id
  Ref: meetup_participants.id < recommendation_place_etas.meetup_participant_id
  Ref: meetup_sessions.(id, chosen_run_id) < recommendation_runs.(meetup_id, id)
  Ref: votes.(meetup_id, run_id) > recommendation_runs.(meetup_id, id)
  Ref: votes.(recommendation_place_id, run_id) > recommendation_places.(id, run_id)
  Ref: votes.(meetup_id, meetup_participant_id) > meetup_participants.(meetup_id, id)
  Ref: user_accounts.id < favorite_places.user_id
  Ref: place_snapshots.id < favorite_places.place_snapshot_id
  Ref: meetup_sessions.id < chat_conversations.meetup_id
  Ref: user_accounts.id < chat_conversations.direct_user_a_id
  Ref: user_accounts.id < chat_conversations.direct_user_b_id
  Ref: chat_conversations.id < chat_conversation_members.conversation_id
  Ref: user_accounts.id < chat_conversation_members.user_id
  Ref: chat_messages.id < chat_conversation_members.last_read_message_id
  Ref: chat_conversations.id < chat_messages.conversation_id
  Ref: user_accounts.id < chat_messages.sender_user_id
  Ref: chat_messages.id < chat_message_attachments.message_id
  Ref: chat_messages.id < chat_conversations.last_message_id
  Ref: user_accounts.id < device_tokens.user_account_id
  Ref: user_accounts.id < notification_campaigns.created_by_user_id
  Ref: user_accounts.id < notification_deliveries.recipient_user_id
  Ref: device_tokens.id < notification_deliveries.device_id
  Ref: notification_campaigns.id < notification_deliveries.notification_campaign_id
  Ref: meetup_sessions.id < notification_deliveries.meetup_id
  Ref: recommendation_runs.id < ai_explanation_cache.recommendation_run_id
  Ref: user_accounts.id < nearby_preferences.user_id
  Ref: user_accounts.id < nearby_suggestion_cooldowns.user_a_id
  Ref: user_accounts.id < nearby_suggestion_cooldowns.user_b_id
  Ref: user_accounts.id < user_reports.reporter_id
  Ref: user_accounts.id < user_reports.reported_user_id
  Ref: user_accounts.id < user_reports.handled_by_id
  Ref: user_accounts.id < audit_logs.actor_id

  // Redis keys. They are deliberately not relational tables and have TTL.
  // location:{userId} -> latitude, longitude, accuracy, updatedAt; TTL 5 minutes
  // presence:{userId} -> online state, socketId, updatedAt; TTL short
  // active-meetup:{userId} -> meetupId; TTL follows session
  // nearby-cooldown:{userA}:{userB} -> timestamp; TTL 2 hours
